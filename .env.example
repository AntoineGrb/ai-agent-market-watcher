WATCHER_ENV=prod                    # prod | test
ANTHROPIC_API_KEY=
WATCHER_MODEL_TRIAGE=               # optionnel : surcharge de _defaults.yaml
WATCHER_MODEL_ANALYSIS=             # optionnel
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_TO=
HEALTHCHECKS_URL=                   # URL de ping du check de prod (sans suffixe)
HEALTHCHECKS_TEST_URL=              # optionnel : check dédié, pingé seulement si WATCHER_ENV=test
SEC_USER_AGENT=                     # ex. "watcher-perso prenom.nom@exemple.com"
WATCHER_UID=                        # optionnel (Docker) : UID du propriétaire de ./data si différent de 1000
